# --- tudo opcional. Sem nada disso o projeto funciona 100% de graca. ---

# PageSpeed Insights. Sem chave a API funciona, mas com cota baixa (e 429 frequente).
# Chave gratuita, NAO precisa de cartao: console.cloud.google.com > APIs > PageSpeed Insights API
PSI_API_KEY=

# Deixe vazio para usar SQLite local (leads.db).
# Para migrar pro Neon depois, cole a connection string aqui e instale psycopg:
# PNB_DB_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
PNB_DB_URL=

# User-Agent enviado ao Nominatim/Overpass. Boa pratica: coloque seu email.
PNB_UA=proof-n-brand/0.1 (contato: seu@email.com)
